{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Core Upgrade Proposal v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "proposal_id", "target", "created_utc", "summary", "changes", "proposal_hash"],
  "properties": {
    "v": { "type": "string", "const": "upgrade_proposal_v3" },

    "proposal_id": { "type": "string", "minLength": 8 },

    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": { "type": "string", "minLength": 2 },
        "version": { "type": "string", "minLength": 1 }
      }
    },

    "created_utc": { "type": "string", "minLength": 10 },
    "summary": { "type": "string", "minLength": 5 },

    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change_id", "type", "detail"],
        "properties": {
          "change_id": { "type": "string", "minLength": 4 },
          "type": { "type": "string", "enum": ["add", "modify", "deprecate", "remove"] },
          "detail": { "type": "string", "minLength": 3 }
        }
      }
    },

    "evidence": { "type": "object" },

    "guardrails": {
      "type": "array",
      "items": { "type": "string" }
    },

    "guardrails_ref": { "type": "string" },

    "proposal_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
